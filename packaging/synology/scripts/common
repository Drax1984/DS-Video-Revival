# Gemeinsame Definitionen der Paketskripte (wird per "." eingebunden).
PKG_NAME="dsvideorevival"
PKG_VAR="${SYNOPKG_PKGVAR:-/var/packages/$PKG_NAME/var}"
PKG_DEST="${SYNOPKG_PKGDEST:-/var/packages/$PKG_NAME/target}"
BIN="$PKG_DEST/bin/dsvr"
CONFIG="$PKG_VAR/config.json"
PID_FILE="$PKG_VAR/dsvr.pid"
LOG_FILE="$PKG_VAR/dsvr.log"
LOG_MAX_BYTES=5242880

# Verzeichnisname des passenden Binaries für diese CPU.
arch_dir() {
    case "$(uname -m)" in
        x86_64|amd64)          echo x86_64 ;;
        aarch64|arm64|armv8*)  echo aarch64 ;;
        armv7*|armv8l)         echo armv7 ;;
        armv5*|armv6*)         echo armv5 ;;
        i386|i486|i586|i686)   echo i686 ;;
        *) echo "Nicht unterstützte CPU-Architektur: $(uname -m)" >&2; return 1 ;;
    esac
}

log_msg() {
    echo "$(date '+%Y/%m/%d %H:%M:%S') [paket] $*" >> "$LOG_FILE" 2>/dev/null
}
