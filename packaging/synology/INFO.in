package="dsvideorevival"
version="@VERSION@"
os_min_ver="7.2-64561"
arch="noarch"
displayname="DS Video Revival"
description="Kompatibler Server für die Original-DS-Video-Apps (iOS, Android, Android TV, Apple TV) nach dem Wegfall von Video Station. Wie früher erreichen die Apps die NAS über die normale DSM-Adresse (ohne Portangabe); DSM reicht ihre Aufrufe an dieses Paket weiter. Optional auch für Jellyfin-Apps (Infuse, Swiftfin, Jellyfin für Android TV). Eigenständige Neuentwicklung, enthält keine Synology-Software, kein offizielles Synology-Produkt."
description_enu="Compatible server for the original DS video apps after the removal of Video Station. As before, the apps connect to the regular DSM address; DSM forwards their requests to this package. Optionally also for Jellyfin apps (Infuse, Swiftfin, Jellyfin for Android TV). Independent implementation, contains no Synology software, not affiliated with Synology."
displayname_ger="DS Video Revival"
description_ger="Kompatibler Server für die Original-DS-Video-Apps nach dem Wegfall von Video Station. Die Apps verbinden sich wie früher mit der normalen DSM-Adresse. Optional auch für Jellyfin-Apps (Infuse, Swiftfin, Jellyfin für Android TV). Eigenständige Neuentwicklung, kein offizielles Synology-Produkt."
maintainer="DS Video Revival Project"
thirdparty="yes"
startable="yes"
ctl_stop="yes"
silent_upgrade="yes"
dsmuidir="ui"
dsmappname="SYNO.SDS.DSVideoRevival"
adminprotocol="http"
adminport="@PORT@"
adminurl="/dsvr/"
instuninst_restart_services="nginx.service"
